# DSH 插件测评站 · 容器部署参数（复制为 docker/.env 后按需修改）
#
#   cp .env.example .env
#
# 这个文件里既有**compose 插值变量**（DSH_REVIEW_DATA_DIR 等，被 compose.yaml 读取），
# 也有**应用变量**（由 env_file 注入容器）。两类混在一个文件是刻意的：
# 部署时只有一处要维护，不会出现"改了 .env 但 compose 没读到"。
#
# ⚠️ .env 必须 chmod 600，绝不能进 git（已在 .gitignore 里）。

# ===========================================================================
# 一、compose 插值（影响容器怎么起）
# ===========================================================================
# 宿主数据目录。默认落在 /root 下 —— 主人的要求是"除 /root 外不留痕迹"。
DSH_REVIEW_DATA_DIR=/root/dsh-plugin-review/data
# 部署根目录（证书等）与两个对外端口
DSH_REVIEW_ROOT=/root/dsh-plugin-review
DSH_REVIEW_HTTP_PORT=80
DSH_REVIEW_HTTPS_PORT=443
# 数据目录属主与容器内 UID 不一致时覆盖（两者必须一致，否则容器写不进库）
DSH_REVIEW_UID=10001
DSH_REVIEW_GID=10001

# ===========================================================================
# 二、应用变量（注入容器）
# ===========================================================================
# 数据库与媒体目录：**容器内路径**，不要改（compose 已固定在 /app/.data）
DSH_REVIEW_DB_PATH=/app/.data/app.sqlite
DSH_REVIEW_MEDIA_ROOT=/app/.data/media

# 会话与登录挑战的共享密钥：至少 32 字节。**生产必须设置**，
# 否则服务端拒绝发起 GitHub 登录（避免明文保存 PKCE verifier）。
# 生成：openssl rand -base64 48
SESSION_SECRET=

# GitHub OAuth App（回调必须与 App 页里填的完全一致）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1/api/auth/github/callback
# 可选：只读令牌，仅用于提高插件收录检查的接口限额（60 → 5000 次/小时）
GITHUB_TOKEN=

# 首个管理员：GitHub **稳定数字 ID**（不是用户名）。
# 语义是"引导"：只有当库里一个可用管理员都没有时才生效。
BOOTSTRAP_ADMIN_GITHUB_ID=

# 超级管理员：GitHub **稳定数字 ID**。部署时绑定、唯一、站内不可剥夺、不可转移；
# 该身份登录即被提升为管理员，且**只有他**能授予/撤销管理员（需手打对方昵称确认）。
# 换人只能改这一行 + 重启服务。留空 = 没有超管，站内谁都授不了管理员（fail-closed）。
SUPER_ADMIN_GITHUB_ID=

# 内容筛查：留空=不自动放行（进入人工审核）；basic=本地确定性筛查（仅演示用）
DSH_REVIEW_CONTENT_SCREEN=

# 访问日志里记录真实 IP 时**必须**为 1（本编排的 web 只给 nginx 反代，不发布端口）。
# 若为了调试把 web 端口发布到公网，请改成 0 —— 否则客户端可以伪造 X-Real-IP。
DSH_REVIEW_TRUST_PROXY=1

# 健康检查详情（?detail=1）需要的口令，至少 16 位；不设则详情一律不下发。
DSH_REVIEW_HEALTH_TOKEN=

# 生产但**暂时没有 TLS** 时才设 1（例如先用 http://<IP> 试跑）：
# 会话 Cookie 会退回开发那套（不带 __Host- 前缀与 Secure），链路不安全。
# **上了 HTTPS 立刻删掉这一行。**
DSH_REVIEW_INSECURE_COOKIES=1

# 离线/CI：设 1 时收录检查不做出网调用（避免把"没网"误判成"仓库不合规"）
DSH_REVIEW_CATALOG_OFFLINE=

# 测试登录通道：只有值正好为 1 且非生产时可用。**生产保持留空。**
DSH_REVIEW_ALLOW_TEST_LOGIN=