{
  "name": "dsh-plugin-review",
  "version": "0.1.0-slice",
  "private": true,
  "type": "module",
  "description": "DSH Plugin Review · 最小功能切片（登录 → 收录插件 → 写/审/发一篇评测 → 评论）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:test": "set NODE_ENV=test&& next dev -p 3100",
    "build": "next build",
    "start": "node server.mjs",
    "start:next": "next start -p 3100",
    "worker": "tsx src/worker/main.ts",
    "db:migrate": "tsx src/server/platform/migrate-cli.ts",
    "db:check": "tsx src/server/platform/selfcheck-cli.ts",
    "admin:super": "node scripts/set-super-admin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.0",
    "rate-limiter-flexible": "11.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
